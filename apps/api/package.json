{
  "name": "@hannibox/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "wrangler types --env-interface CloudflareBindings --check && tsc"
  },
  "dependencies": {
    "@hannibox/auth": "workspace:*",
    "@hannibox/db": "workspace:*",
    "@hannibox/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "wrangler": "^4.147.0"
  }
}
